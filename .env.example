# ---------------------------------------------------------------------------
# Modèle de configuration.
# Copiez ce fichier en « .env » puis remplissez vos valeurs.
# Le fichier .env ne doit JAMAIS être publié sur GitHub (voir .gitignore).
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clé SECRÈTE (recommandée) : « Secret key » dans le tableau de bord Supabase.
# Elle reste côté serveur et n'est JAMAIS publiée.
SUPABASE_SECRET_KEY=sb_secret_collez_ici_la_cle_secrete

# Clé publique (mode dégradé seulement, si vous n'avez pas de clé secrète :
# la table doit alors avoir des politiques RLS ouvertes).
SUPABASE_ANON_KEY=

# Optionnel : clé API AbuseIPDB (gratuite sur https://www.abuseipdb.com/account/api).
# Si elle est renseignée, elle remplace ip-api.com pour la réputation des IP.
ABUSEIPDB_API_KEY=

# Optionnel : clé secrète Flask (sessions / messages flash).
FLASK_SECRET_KEY=changez-cette-valeur
